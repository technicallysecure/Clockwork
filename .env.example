# Docker Desktop on Core-2. These deployment defaults seed each agent.
# The web UI saves agent-specific model settings in its own data volume.
# Local-only mode is an operator ceiling across all agents.
CLOCKWORK_HOST_PORT=8787
# compose.plan.yaml publishes the browser callback on Windows loopback.
# CLOCKWORK_PLAN_CALLBACK_PORT=12003
CLOCKWORK_LOCAL_ONLY=true
CLOCKWORK_LM_BASE_URL=http://host.docker.internal:1234/v1
CLOCKWORK_LM_MODEL=local-model
CLOCKWORK_LM_TOOLS=false
CLOCKWORK_OPENAI_MODEL=gpt-4.1-mini
# Set to true only for a model you have verified can call tools.
# CLOCKWORK_OPENAI_TOOLS=true
CLOCKWORK_DEFAULT_PROFILE=local
